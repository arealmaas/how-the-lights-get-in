# Copy to .env.local (gitignored) to run the live crew flow: `npm run test:live` (see README, "Live crew flow").
# Two email + password accounts on the Firebase project in data/firebase.json. They are signed in by a headless
# browser, made to create, join and close a crew, and reset to "no crew" server-side. Never real people's accounts.
HTLGI_TEST_A_EMAIL=
HTLGI_TEST_A_PASSWORD=
HTLGI_TEST_B_EMAIL=
HTLGI_TEST_B_PASSWORD=
